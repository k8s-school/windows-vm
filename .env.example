# Copy to .env and adapt. All variables are optional.
# Windows version: 11 (Pro, not activated), 11e (Enterprise evaluation, 90 days), 10, 10e, ...
WIN_VERSION=11
WIN_LANGUAGE=French
WIN_REGION=fr-FR
WIN_KEYBOARD=fr-FR
WIN_RAM=8G
WIN_CPUS=4
WIN_DISK=64G
WIN_USER=user
WIN_PASSWORD=changeme
# USB passthrough: give a USB device to Windows (IDs from `lsusb`, here a NUX MG-50 pedal).
# While the VM runs, the device is no longer available on Linux.
#WIN_ARGUMENTS=-device usb-host,vendorid=0x3703,productid=0x2000
